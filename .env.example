# AI 智能助手 环境配置
# 复制此文件为 .env 并填入你的配置
# 注意：调优参数（temperature、RAG 参数等）已迁移至运行时配置，
#       通过 UI「设置 → 高级」面板管理，持久化于 data/runtime_settings.json

# ========== 必需配置 ==========

# Tavily 联网搜索 API Key（必填以启用联网搜索）
# 申请地址：https://app.tavily.com
# 不填则前端联网搜索按钮不可用
TAVILY_API_KEY=

# ========== Ollama 模型服务 ==========

# Ollama 服务地址，默认为本机 11434 端口
# 远程服务器示例：http://192.168.1.100:11434
OLLAMA_HOST=http://localhost:11434

# 默认对话模型名，通过 ollama list 查看已安装的模型
# 常见选择：qwen3.5:9B、llama3.2:3b、deepseek-r1:7b
OLLAMA_MODEL=qwen3.5:9B

# 模型响应超时时间（秒）
# 联网搜索或长思考模型（如 deepseek-r1）可适当增大到 180–300
OLLAMA_TIMEOUT=300

# 模型保持加载时长，防频繁卸载重载（每次重载 5-30 秒）
# 格式：数字+单位，如 "30m"（30分钟）、"1h"（1小时）、"-1"（永久）
# 设 "-1" 最流畅，但会持续占用显存
OLLAMA_KEEP_ALIVE=30m

# 上下文窗口大小，决定模型一次能看到多少历史
# qwen3.5 支持 32768（32K），deepseek-r1 支持 16384
# 设太大耗显存，设太小长对话会被截断
OLLAMA_NUM_CTX=32768

# 批处理 token 数，影响生成速度
# 默认 512，GPU 显存充裕可提至 1024–2048 提速
OLLAMA_NUM_BATCH=512

# ========== 对话 ==========

# 单条消息最大字符数，超出部分前端自动截断
MAX_INPUT_LENGTH=2000

# ========== RAG / 知识库检索 ==========

# Embedding 模型名，用于将文本转为向量
# 必须为 ollama 中已安装的模型
EMBEDDING_MODEL=bge-m3

# ========== 联网搜索 ==========

# 联网搜索提供商（duckduckgo：免费，无需 Key；tavily：付费，需填写 API Key）
SEARCH_PROVIDER=duckduckgo

# ========== 文件上传 ==========

# 上传文件大小上限（字节），默认 30MB
# 计算公式：30 * 1024 * 1024 = 31457280
MAX_UPLOAD_SIZE=31457280

# ========== 数据库 ==========

# SQLite 数据库文件路径，相对于项目根目录
# 包含会话、消息、索引任务记录
DB_PATH=data/chat.db

# ChromaDB 向量数据库持久化目录
# 删除此目录会丢失所有文件索引，需要重新上传并索引
CHROMA_PERSIST_DIR=data/chroma_db

# ========== 日志 ==========

# 日志级别：DEBUG / INFO / WARNING / ERROR
# DEBUG 会输出详细的请求和 SQL 日志
LOG_LEVEL=INFO

# ========== 系统提示词 ==========

# 自定义系统提示词，覆盖默认的 AI 助手身份和行为规范
# 留空则使用 config.py 中的默认提示词
# SYSTEM_PROMPT=

# ========== 服务 ==========

# CORS 允许的跨域来源，JSON 数组格式
# 开发阶段可用 ["*"]，生产环境建议设为具体域名如 ["https://app.example.com"]
CORS_ORIGINS=["*"]

# ========== 调优参数（通过 UI 设置面板配置）==========

# 以下参数已从 .env 移除，统一通过"设置 → 高级"面板管理：
#   temperature / top_p / max_output_tokens / max_history_messages
#   max_context_tokens / rag_enabled / rag_chunk_size / rag_chunk_overlap
#   rag_top_k / rag_score_threshold / rag_query_rewrite / rag_hyde_*
#   rag_candidate_k / rag_bm25_weight / search_max_results
#   search_max_context_tokens
# 修改后重启应用即可生效（若 runtime_settings.json 不存在时自动从旧 .env 迁移）
