# AI 智能助手 环境配置
# 复制此文件为 .env 并填入你的配置
# 注意：调优参数（temperature、RAG 参数等）已迁移至运行时配置，
#       通过 UI「设置 → 高级」面板管理，持久化于 data/runtime_settings.json

# ========== Ollama 模型服务 ==========

# Ollama 服务地址，默认为本机 11434 端口
# 远程服务器示例：http://192.168.1.100:11434
OLLAMA_HOST=http://localhost:11434

# 默认对话模型名，通过 ollama list 查看已安装的模型
OLLAMA_MODEL=qwen3.5:9B

# 模型响应超时时间（秒）
# 长思考模型（如 deepseek-r1）或启用联网搜索时可适当增大到 180–300
OLLAMA_TIMEOUT=300

# 模型保持加载时长，防频繁卸载重载（每次重载 5-30 秒）
# 格式：数字+单位，如 "30m"（30分钟）、"1h"（1小时）、"-1"（永久）
# 设 "-1" 最流畅，但会持续占用显存；代码默认值为 "-1"
OLLAMA_KEEP_ALIVE=30m

# 上下文窗口大小，决定模型一次能看到多少历史
# qwen3.5 支持 32768（32K），deepseek-r1 支持 16384
# 设太大耗显存，设太小长对话会被截断；代码默认值为 20480
OLLAMA_NUM_CTX=32768

# 批处理 token 数，影响生成速度
# 默认 512，GPU 显存充裕可提至 1024–2048 提速；代码默认值为 2048
OLLAMA_NUM_BATCH=512

# ========== 对话 ==========

# 单条消息最大字符数，超出部分前端自动截断
MAX_INPUT_LENGTH=2000

# ========== RAG / 知识库检索 ==========

# Embedding 模型名，用于将文本转为向量
# 必须为 ollama 中已安装的模型
EMBEDDING_MODEL=bge-m3

# 语义记忆开关，关闭后不再检索历史消息作为上下文
# MEMORY_ENABLED=true

# 向量检索距离度量方式（cosine / l2 / ip）
# RAG_DISTANCE_METRIC=cosine

# ========== 联网搜索 ==========

# 搜索提供商（duckduckgo：免费，无需 Key；tavily：付费，需填写 API Key）
SEARCH_PROVIDER=duckduckgo

# Tavily Search API Key（使用 Tavily 时必填）
# 申请地址：https://app.tavily.com
TAVILY_API_KEY=

# 搜索缓存有效期（秒），相同查询在有效期内直接返回缓存
# SEARCH_CACHE_TTL=300

# LLM 搜索意图预判开关，关闭后每次提问都执行搜索
# WEB_SEARCH_PRECHECK=true

# ========== 文件上传 ==========

# 上传文件大小上限（字节），默认 30MB
# 计算公式：30 * 1024 * 1024 = 31457280
MAX_UPLOAD_SIZE=31457280

# 上传文件存储目录，相对于项目根目录
# UPLOAD_DIR=uploads

# ========== 数据库 ==========

# SQLite 数据库文件路径，相对于项目根目录
# 包含会话、消息、索引任务记录
DB_PATH=data/chat.db

# ChromaDB 向量数据库持久化目录
# 删除此目录会丢失所有文件索引，需要重新上传并索引
CHROMA_PERSIST_DIR=data/chroma_db

# ========== 日志 ==========

# 日志级别：DEBUG / INFO / WARNING / ERROR
# DEBUG 会输出详细的请求和 SQL 日志
LOG_LEVEL=INFO

# ========== 系统提示词 ==========

# 自定义系统提示词，覆盖默认的 AI 助手身份和行为规范
# 留空则使用 config.py 中的默认提示词
# SYSTEM_PROMPT=

# 系统提示词文件路径，相对于项目根目录
# 默认读取 prompts/default_system.md
# SYSTEM_PROMPT_PATH=prompts/default_system.md

# ========== 服务 ==========

# FastAPI 监听端口
# PORT=8001

# 开发模式热重载（修改代码后自动重启）
# DEV_RELOAD=false

# 自定义模型来源，JSON 数组格式
# 示例：[{"name":"my-vllm","label":"我的vLLM","type":"openai","base_url":"http://10.0.0.1:8000","api_key":"sk-..."}]
# 不填则仅使用本地 Ollama
# MODEL_SOURCES=

# CORS 允许的跨域来源，JSON 数组格式
# 开发阶段可用 ["*"]，生产环境建议设为具体域名如 ["https://app.example.com"]
CORS_ORIGINS=["*"]
